import rclpy
from rclpy.node import Node
from sensor_msgs.msg import CompressedImage
from std_msgs.msg import String
import cv2
import numpy as np
import os

try:
    from ultralytics import YOLO
except ImportError:
    YOLO = None


class ObjectRecognizer(Node):
    """
    ROS 2 Node that processes raw camera images using a trained YOLOv8/YOLO11 model
    to detect traffic sign boards and arrows, publishing combined labels like 'A_LEFT'
    to the /sign_board_detection topic.
    """

    def __init__(self):
        super().__init__('object_recognizer')

        self.subscription_camera = self.create_subscription(
            CompressedImage, '/camera/image_raw/compressed', self.camera_image_callback, 10)

        self.publisher_sign = self.create_publisher(
            String, '/sign_board_detection', 10)

        self.model = None
        if YOLO is not None:
            try:
                dir_path = os.path.dirname(os.path.abspath(__file__))
                model_path = os.path.join(dir_path, 'best.pt')
                if os.path.exists(model_path):
                    self.model = YOLO(model_path)
                    self.get_logger().info(f"Loaded YOLO model from {model_path}")
                else:
                    self.get_logger().warn(f"YOLO model file not found at {model_path}. Please place 'best.pt' in {dir_path}")
            except Exception as e:
                self.get_logger().error(f"Failed to load YOLO model: {e}")
        else:
            self.get_logger().warn("Ultralytics library is not installed. Run: pip install ultralytics")

        self.get_logger().info("Object Recognizer Node started. Waiting for images...")

    def camera_image_callback(self, message):
        """Processes incoming compressed camera frames using YOLO."""
        np_arr = np.frombuffer(message.data, np.uint8)
        image = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)

        sign_detected = self.classify_sign(image)
        if sign_detected is not None:
            msg = String()
            msg.data = sign_detected
            self.publisher_sign.publish(msg)
            self.get_logger().info(f"Detected Sign Board Command: {sign_detected}")

    def classify_sign(self, image):
        """
        Runs YOLO inference on the image, extracting detected letters (A, B, C, X, Y, Z)
        and direction arrows (Left, Right, Straight), pairing them into a command string.
        """
        if self.model is None or image is None:
            return None

        try:
            # Run inference (conf threshold at 0.50 as specified)
            results = self.model.predict(
                source=image,
                imgsz=512,
                conf=0.50,
                verbose=False
            )

            if not results or len(results) == 0:
                return None

            boxes = results[0].boxes
            if boxes is None or len(boxes) == 0:
                return None

            names = results[0].names

            letters = []
            directions = []

            for box in boxes:
                cls_id = int(box.cls[0].item())
                label = names.get(cls_id, "")
                conf = box.conf[0].item()

                if label in ["A", "B", "C", "X", "Y", "Z"]:
                    letters.append((label, conf))
                elif label.upper() in ["LEFT", "RIGHT", "STRAIGHT"]:
                    directions.append((label.upper(), conf))

            # Pair highest-confidence letter with highest-confidence direction
            if letters and directions:
                best_letter = max(letters, key=lambda x: x[1])[0]
                best_direction = max(directions, key=lambda x: x[1])[0]
                return f"{best_letter}_{best_direction}"
            elif letters:
                # Fallback: if letter seen without clear arrow, return letter alone
                best_letter = max(letters, key=lambda x: x[1])[0]
                return f"{best_letter}_STRAIGHT"

        except Exception as e:
            self.get_logger().debug(f"YOLO inference error: {e}")

        return None


def main(args=None):
    rclpy.init(args=args)
    node = ObjectRecognizer()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
